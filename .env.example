# --- Database ---
# These use Docker service names/ports (for containers talking to each other).
# docker-compose.yml maps postgres to host port 5433 and redis to host port 6380
# (not the defaults 5432/6379) to avoid clashing with any native install on your
# machine — if running tools *outside* Docker (psql, pytest, a local uvicorn), use
# localhost:5433 / localhost:6380 instead.
POSTGRES_USER=pulsesearch
POSTGRES_PASSWORD=pulsesearch
POSTGRES_DB=pulsesearch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pulsesearch:pulsesearch@postgres:5432/pulsesearch

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# --- Embeddings ---
# EMBEDDING_PROVIDER=local uses the offline sentence-transformers model below.
# Set EMBEDDING_PROVIDER=hosted to call an OpenAI-compatible /embeddings API
# instead (OpenAI itself, or any compatible endpoint) — trades zero-cost/offline
# for higher embedding quality. Requires EMBEDDING_API_BASE_URL/_KEY/_MODEL.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# --- Search quality ---
# Reranking uses a local cross-encoder as a second pass over the top retrieval
# candidates for better relevance ordering. Adds latency + a second model load;
# disable for the fastest possible search.
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=10

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- Storage ---
# STORAGE_BACKEND=local writes to UPLOAD_DIR on disk (default, zero-config).
# Set STORAGE_BACKEND=s3 to use S3 or an S3-compatible endpoint (e.g. MinIO via
# S3_ENDPOINT_URL) so uploads scale independently of the API/worker processes.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Database read routing ---
# Optional read replica; falls back to DATABASE_URL when unset.
DATABASE_URL_REPLICA=

# --- Observability ---
# The API exposes Prometheus metrics at :8000/metrics. The worker records its
# own (documents_processed_total, embedding_generation_seconds) but has no web
# server, so it runs a small standalone metrics server on this port instead.
WORKER_METRICS_PORT=9100

# --- Demo data ---
# On registration, every new account gets 3 real documents (about PulseSearch
# itself) pushed through the actual upload/processing pipeline, so a fresh
# account isn't an empty shell. Set to false to disable.
SEED_DEMO_DOCUMENTS=true

# --- AI Q&A ---
# Ask a question in plain English and get a synthesized answer with citations,
# instead of a list of search results — retrieval-augmented generation built
# on the same hybrid-search + reranking pipeline /api/search uses. Off by
# default: unlike every other feature here, each request costs real money.
# Get a key at https://console.anthropic.com/.
AI_ANSWERS_ENABLED=false
ANTHROPIC_API_KEY=
AI_ANSWERS_MODEL=claude-opus-5
AI_ANSWERS_MAX_TOKENS=1024
AI_ANSWERS_EFFORT=medium
AI_ANSWERS_CONTEXT_CHUNKS=5
AI_ANSWERS_CACHE_TTL_SECONDS=300
RATE_LIMIT_ASK_PER_MINUTE=10

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
